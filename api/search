roubleshooting-3","page_id":"/docs/troubleshooting","type":"heading","tags":[],"url":"/docs/troubleshooting#staff-actions","content":"Staff actions"},"891":{"id":"/docs/troubleshooting-4","page_id":"/docs/troubleshooting","type":"heading","tags":[],"url":"/docs/troubleshooting#transcripts--closing","content":"Transcripts & closing"},"892":{"id":"/docs/troubleshooting-5","page_id":"/docs/troubleshooting","type":"heading","tags":[],"url":"/docs/troubleshooting#messages--text","content":"Messages & text"},"893":{"id":"/docs/troubleshooting-6","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                            | Fix                                                               |\n| ---------------------------------- | ----------------------------------------------------------------- |\n| No servers on the **Servers** page | You need to be the owner or have **Manage Server** on the server. |","table":"table-0"},"894":{"id":"/docs/troubleshooting-7","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                      | Fix                                                                 |\n| -------------------------------------------- | ------------------------------------------------------------------- |\n| `Bot is not in this server` in the dashboard | Click **Add to Server** on that server's page and let the bot join. |","table":"table-0"},"895":{"id":"/docs/troubleshooting-8","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                        | Fix                                                                                           |\n| ---------------------------------------------- | --------------------------------------------------------------------------------------------- |\n| `Sign-in failed - Missing authorisation code.` | The sign-in URL was opened without a Discord code. Start again from **Sign in with Discord**. |","table":"table-0"},"896":{"id":"/docs/troubleshooting-9","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                                           | Fix                                                                                                          |\n| ----------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------ |\n| `Sign-in failed - OAuth token exchange failed. Please try again.` | Discord refused the login exchange. Retry, and if it keeps happening the app's sign-in may be misconfigured. |","table":"table-0"},"897":{"id":"/docs/troubleshooting-10","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                                 | Fix                                                 |\n| ------------------------------------------------------- | --------------------------------------------------- |\n| `Sign-in failed - Could not load your Discord profile.` | A temporary Discord API problem. Retry in a moment. |","table":"table-0"},"898":{"id":"/docs/troubleshooting-11","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                     | Fix                                                                            |\n| --------------------------- | ------------------------------------------------------------------------------ |\n| `Sign-in error - <message>` | An unexpected error during sign-in. Retry; if it persists, report the message. |","table":"table-0"},"899":{"id":"/docs/troubleshooting-12","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                       | Fix                                                                                          |\n| --------------------------------------------- | -------------------------------------------------------------------------------------------- |\n| `Not found - That sign-in link is not valid.` | You opened an old or malformed `/oauth/...` URL. Go back to the dashboard and sign in again. |","table":"table-0"},"900":{"id":"/docs/troubleshooting-13","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                           | Fix                                                                        |\n| --------------------------------- | -------------------------------------------------------------------------- |\n| `Image must be a URL or data URI` | Avatar/banner fields accept only `https://...` or `data:image/...` values. |","table":"table-0"},"901":{"id":"/docs/troubleshooting-14","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                    | Fix                                                                             |\n| -------------------------- | ------------------------------------------------------------------------------- |\n| `That URL is not an image` | The URL returned a non-image content type. Link directly to a PNG/JPG/GIF/WebP. |","table":"table-0"},"902":{"id":"/docs/troubleshooting-15","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                     | Fix                                         |\n| --------------------------- | ------------------------------------------- |\n| `Image is larger than 8 MB` | Shrink the image or host a smaller version. |","table":"table-0"},"903":{"id":"/docs/troubleshooting-16","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                             | Fix                                                                                                         |\n| ----------------------------------- | ----------------------------------------------------------------------------------------------------------- |\n| `Discord rejected the profile: ...` | Discord refused the nickname/avatar/banner/bio. Check the image and try a shorter bio (190 characters max). |","table":"table-0"},"904":{"id":"/docs/troubleshooting-17","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                                              | Fix                                                                                                                   |\n| ---------------------------------------------------- | --------------------------------------------------------------------------------------------------------------------- |\n| Sign-in returns to the landing page and does nothing | Your Discord session expired - sign in again. If it says the sign-in expired, the Discord token lapsed; re-authorise. |","table":"table-0"},"905":{"id":"/docs/troubleshooting-18","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                    | Fix                                                           |\n| -------------------------- | ------------------------------------------------------------- |\n| A panel shows `not posted` | Open it and press **Save changes** to post it to the channel. |","table":"table-0"},"906":{"id":"/docs/troubleshooting-19","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                         | Fix                                                            |\n| ------------------------------- | -------------------------------------------------------------- |\n| A changed setting had no effect | You may not have pressed **Save settings** / **Save changes**. |","table":"table-0"},"907":{"id":"/docs/troubleshooting-20","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom                          | Fix                                                                        |\n| -------------------------------- | -------------------------------------------------------------------------- |\n| A panel/type value seems ignored | Panels and types override server defaults - check the panel and its types. |","table":"table-0"},"908":{"id":"/docs/troubleshooting-21","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#dashboard","content":"| Symptom          | Fix                                                                                 |\n| ---------------- | ----------------------------------------------------------------------------------- |\n| The theme resets | The choice is stored per-browser; a different browser or a cleared cache resets it. |","table":"table-0"},"909":{"id":"/docs/troubleshooting-22","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                                      | Fix                                                                           |\n| -------------------------------------------- | ----------------------------------------------------------------------------- |\n| Nothing happens when a user clicks the panel | Make sure the bot was invited with the permissions it asks for (Permissions). |","table":"table-1"},"910":{"id":"/docs/troubleshooting-23","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                                 | Fix                           |\n| --------------------------------------- | ----------------------------- |\n| `You're not allowed to open tickets...` | The user is on the blacklist. |","table":"table-1"},"911":{"id":"/docs/troubleshooting-24","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                             | Fix                                                              |\n| ----------------------------------- | ---------------------------------------------------------------- |\n| `You already have N open ticket(s)` | Raise **Max open tickets per user** or have them close a ticket. |","table":"table-1"},"912":{"id":"/docs/troubleshooting-25","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                                     | Fix                                                                                                                      |\n| ------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `Sorry, I couldn't create your ticket: ...` | Usually a missing category or a permission problem in the ticket category. Check the category and the bot's permissions. |","table":"table-1"},"913":{"id":"/docs/troubleshooting-26","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                | Fix                                                                                                                    |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| Panel shows no options | The panel has no ticket types, or you used **Buttons** style with more than 5 types. Use **Dropdown** for more than 5. |","table":"table-1"},"914":{"id":"/docs/troubleshooting-27","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                                  | Fix                                                                                                       |\n| ---------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| The second (sub-type) menu never appears | The type has no sub-types, or they failed to parse. Format is `emoji label \\| description`, one per line. |","table":"table-1"},"915":{"id":"/docs/troubleshooting-28","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#opening-tickets","content":"| Symptom                          | Fix                                                                                                                                                                               |\n| -------------------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Staff cannot see a thread ticket | Private threads are only visible to members and users with **Manage Threads**. Grant that permission or **Add User** the staff member - or switch the panel to `Private channel`. |","table":"table-1"},"916":{"id":"/docs/troubleshooting-29","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#staff-actions","content":"| Symptom             | Fix                                                                                  |\n| ------------------- | ------------------------------------------------------------------------------------ |\n| `Only staff can...` | You need **Manage Channels**, or a role listed in **Staff roles** / **Admin roles**. |","table":"table-2"},"917":{"id":"/docs/troubleshooting-30","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#staff-actions","content":"| Symptom                                        | Fix                                |\n| ---------------------------------------------- | ---------------------------------- |\n| `You need the **Manage Server** permission...` | Same - the command is staff-gated. |","table":"table-2"},"918":{"id":"/docs/troubleshooting-31","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#staff-actions","content":"| Symptom                        | Fix                                                                  |\n| ------------------------------ | -------------------------------------------------------------------- |\n| `This channel isn't a ticket.` | The command only works inside a ticket channel that the bot created. |","table":"table-2"},"919":{"id":"/docs/troubleshooting-32","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#transcripts--closing","content":"| Symptom                       | Fix                                                                                                                        |\n| ----------------------------- | -------------------------------------------------------------------------------------------------------------------------- |\n| No transcript posted on close | Set a **Transcript channel** (or **Log channel**). The transcript is still saved and reachable in the **Transcripts** tab. |","table":"table-3"},"920":{"id":"/docs/troubleshooting-33","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#transcripts--closing","content":"| Symptom                                 | Fix                                                                        |\n| --------------------------------------- | -------------------------------------------------------------------------- |\n| Transcript is missing the last messages | Transcripts are capped at 2000 messages; very large tickets are truncated. |","table":"table-3"},"921":{"id":"/docs/troubleshooting-34","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#transcripts--closing","content":"| Symptom                         | Fix                                                                                         |\n| ------------------------------- | ------------------------------------------------------------------------------------------- |\n| The opener didn't get a DM copy | They have DMs closed. Turn on **DM the opener a copy** and/or check their privacy settings. |","table":"table-3"},"922":{"id":"/docs/troubleshooting-35","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#transcripts--closing","content":"| Symptom                    | Fix                                                                                                            |\n| -------------------------- | -------------------------------------------------------------------------------------------------------------- |\n| Internal notes are missing | That's by design - notes are never in transcripts. They're posted to the log channel and stored on the ticket. |","table":"table-3"},"923":{"id":"/docs/troubleshooting-36","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#transcripts--closing","content":"| Symptom                         | Fix                                                                                        |\n| ------------------------------- | ------------------------------------------------------------------------------------------ |\n| A transcript row says `deleted` | That is the ticket channel's state, not the transcript's. The **Open** button still works. |","table":"table-3"},"924":{"id":"/docs/troubleshooting-37","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#messages--text","content":"| Symptom                            | Fix                                   |\n| ---------------------------------- | ------------------------------------- |\n| Text shows `{something}` literally | That token isn't a valid placeholder. |","table":"table-4"},"925":{"id":"/docs/troubleshooting-38","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#messages--text","content":"| Symptom                      | Fix                                                                               |\n| ---------------------------- | --------------------------------------------------------------------------------- |\n| My colour change did nothing | Check the **panel** and **ticket type** overrides - they beat the server setting. |","table":"table-4"},"926":{"id":"/docs/troubleshooting-39","page_id":"/docs/troubleshooting","tags":[],"type":"text","url":"/docs/troubleshooting#messages--text","content":"| Symptom                                      | Fix                                                                    |\n| -------------------------------------------- | ---------------------------------------------------------------------- |\n| The bot's messages are in the wrong language | Pick the language again, review the text, and press **Save settings**. |","table":"table-4"},"927":{"id":"/docs/whats-new","page_id":"/docs/whats-new","type":"page","content":"What's new","breadcrumbs":["dat one ticketer"],"tags":[],"url":"/docs/whats-new"},"928":{"id":"/docs/whats-new-0","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new","content":"The user-visible changes added in recent versions."},"929":{"id":"/docs/whats-new-1","page_id":"/docs/whats-new","type":"heading","tags":[],"url":"/docs/whats-new#405","content":"4.0.5"},"930":{"id":"/docs/whats-new-2","page_id":"/docs/whats-new","type":"heading","tags":[],"url":"/docs/whats-new#earlier","content":"Earlier"},"931":{"id":"/docs/whats-new-3","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new","content":"A running list of changes you can see in Discord or the dashboard. Everything else in the wiki\nalready describes the current behaviour."},"932":{"id":"/docs/whats-new-4","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#405","content":"**Server bot profile** - the server page now has a\nBot profile (this server) card for a nickname, avatar, banner and bio\nthat apply to one server only."},"933":{"id":"/docs/whats-new-5","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#405","content":"**Wiki links everywhere** - the dashboard header and footer, the Terms, Privacy and status pages,\nand the bot's `/help` and `/about` replies now link to this wiki."},"934":{"id":"/docs/whats-new-6","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#405","content":"**Restyled transcripts** - the HTML transcript now uses the same\nlight/dark styling as the rest of the service, ends with the brand and site link, and shows\n`No messages.` for an empty ticket."},"935":{"id":"/docs/whats-new-7","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#405","content":"**Styled sign-in errors** - a failed sign-in now shows a proper page\n(`Sign-in failed` / `Sign-in error` / `Not found`) instead of plain text. See\nTroubleshooting."},"936":{"id":"/docs/whats-new-8","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#earlier","content":"**Sign out link** - the dashboard header has a `Sign out` link (`/oauth/logout`)."},"937":{"id":"/docs/whats-new-9","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#earlier","content":"**Panel templates** - `Blank`, `Support`, `Sales`, `Report a user` and `Ban appeal` in the\nnew-panel editor."},"938":{"id":"/docs/whats-new-10","page_id":"/docs/whats-new","tags":[],"type":"text","url":"/docs/whats-new#earlier","content":"This page only lists front-of-house changes. There is no need to update or re-invite the bot for\nany of them."}},"